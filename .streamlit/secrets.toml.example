# نموذج للإعدادات السرية. لا تُرفع secrets.toml إلى GitHub أبدًا (مستبعد في .gitignore).
#
# --- نسخة العرض على Streamlit Community Cloud (تُلصق في: App settings > Secrets) ---
# HC_ENV = "demo"
# HC_DEMO_DATABASE_URL = "postgresql://hc_app:<كلمة سر حساب التطبيق>@<مضيف Neon>/neondb?sslmode=require"
# HC_DEMO_AUDIT_HMAC_KEY = "<مفتاح عشوائي 32 حرفًا أو أكثر>"
# HC_DISPLAY_TZ = "Asia/Aden"
# HC_DEMO_ALLOW_ILLUSTRATIVE_RULES = "true"
# (لا يوضع هنا عنوان حساب المالك ولا HC_ANCHOR_KEY)
#
# --- تطوير محلي ---
HC_ENV = "dev"
HC_DEV_DATABASE_URL = "sqlite:///hc_dev.db"
HC_DEV_AUDIT_HMAC_KEY = "ضعي-هنا-مفتاحًا-عشوائيًا-لا-يقل-عن-32-حرفًا"
HC_DISPLAY_TZ = "Asia/Aden"
